---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found" description="This page doesn't exist.">
  <section class="not-found">
    <div class="wrap">
      <p class="code">404</p>
      <h1>This level hasn't been built yet.</h1>
      <p>The page you're looking for doesn't exist or has moved.</p>
      <a class="btn btn-gold" href="/">Back to the homepage</a>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found { min-height: 80vh; display: grid; align-items: center; padding-block: 160px 100px; }
  .code { font-stretch: 125%; font-weight: 900; font-size: clamp(90px, 18vw, 220px); line-height: .85; color: var(--teal); }
  h1 { margin-top: 24px; font-stretch: 112%; font-weight: 800; font-size: clamp(32px, 4.4vw, 56px); line-height: 1.05; max-width: 18ch; }
  p:not(.code) { margin-top: 18px; color: var(--muted); font-size: 19px; }
  .btn { margin-top: 32px; }
</style>
